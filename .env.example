# Copy to .env and adjust. No API keys belong in this file.
# SQLite path, relative to the repo root. The data/ folder is created on demand.
DATABASE_URL=sqlite:///./data/voice-chatbot.db

# development | production
ENVIRONMENT=development

# Comma-separated CORS allow-list for the staff dashboard and call screen.
CORS_ORIGINS=http://localhost:3000

# Groq API key for the agent LLM (required for real calls; tests use a fake client).
# GROQ_API_KEY=

# Calendar failure injection — dev/test only. App refuses to start if set in production.
# VOICECHAT_CALENDAR_FAILURE_MODE=timeout
# VOICECHAT_CALENDAR_FAILURE_TIMES=1

# Knowledge base mode: none | full_prompt | rag (default rag)
# VOICECHAT_KB_MODE=rag

# BM25 confidence threshold — below this, search_knowledge returns found=false
# VOICECHAT_KB_THRESHOLD=4.0

# Max documents returned by search_knowledge
# VOICECHAT_KB_MAX_RESULTS=3

# Knowledge base directory (default knowledge/)
# VOICECHAT_KB_DIR=knowledge/
